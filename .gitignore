
# نسخة APK ومفاتيح التوقيع — لا تُرفع
apk/

# بيانات الدخول للخادم — FTP host/user/pass. هاد الملف كان مرفوعاً على مستودع
# عام، وكلمة المرور اللي كانت فيه صارت محروقة ولازم تتغيّر من cPanel: شيله من
# HEAD ما بيشيله من تاريخ الـ commits.
.env.deploy

# ناتج بناء الواجهة. `next build` بيعمله في web/out وبينتسخ لهون قبل الرفع،
# فنسخته بالمستودع بتتقادم بصمت. اللي مكتوب بالإيد جوّا هاد المجلّد — واجهة
# Laravel وسياسة الخصوصية — مستثنى تحت.
/.deploy/haya/*
!/.deploy/haya/api/
!/.deploy/haya/privacy/
